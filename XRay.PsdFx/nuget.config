<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Offline-first: a package packed from this repo lands in ./packages and is
       restored from there without touching the network. nuget.org stays listed
       second so the test project's MSTest packages can be restored on a fresh
       machine; delete that line on an air-gapped machine that has them cached. -->
  <packageSources>
    <clear />
    <add key="local" value="packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
