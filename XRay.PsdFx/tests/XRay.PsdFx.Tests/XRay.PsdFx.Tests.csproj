<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net45</TargetFramework>
    <IsPackable>false</IsPackable>
    <LangVersion>7.3</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyName>XRay.PsdFx.Tests</AssemblyName>
    <RootNamespace>XRay.PsdFx.Tests</RootNamespace>
    <!-- Test method names follow the original suite's snake_case convention. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.1.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="2.2.8" />
    <PackageReference Include="MSTest.TestFramework" Version="2.2.8" />
    <!-- ValueTuple lets test payloads and signatures match the original suite. -->
    <PackageReference Include="System.ValueTuple" Version="4.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\XRay.PsdFx\XRay.PsdFx.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="obj\**;bin\**" />
  </ItemGroup>

</Project>
